# redtekno.com.mx — https, sin www y barra final (capitulos 9 y 10 de la guia)
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.redtekno\.com\.mx [NC]
RewriteRule ^(.*)$ https://redtekno.com.mx/$1 [R=301,L]
# carpeta -> barra final (canonical con / final en todas las paginas del silo)
RewriteCond %{REQUEST_URI} !\.(xml|txt|html?|css|js|jpe?g|png|webp|svg|ico|pdf)$
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
ErrorDocument 404 /404.html
DirectoryIndex index.html
